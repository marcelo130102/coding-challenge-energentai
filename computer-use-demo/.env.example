# Copy to `.env` in this folder (`computer-use-demo/`) and/or `backend_fastapi/.env`.
# Both are loaded on startup (`backend_fastapi/main.py`); `backend_fastapi/.env` wins if a key appears in both.
#
# Anthropic keys are entered in the UI per session; the API encrypts them at rest
# when this is set (required if COMPUTER_USE_ORCHESTRATION=true).
#
# Generate once and keep stable (loss or rotation invalidates stored sessions):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# SESSION_API_KEY_FERNET_KEY=paste_the_generated_key_here
#
# Optional. Omit on local dev to use computer_use_demo.db next to this repo.
# Docker Compose may set sqlite:////data/... — on the host, /data is often missing;
# the app then falls back to the default file unless /data is writable.
# DATABASE_URL=sqlite:////data/computer_use_demo.db
